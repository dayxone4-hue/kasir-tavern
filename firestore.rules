rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }
    // Pekerja terdaftar: hanya bisa dibuat sendiri dengan kode verifikasi yang benar.
    match /staff/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username','role','ts','code'])
        && request.resource.data.role == 'barista'
        && request.resource.data.code == get(/databases/$(database)/documents/config/reg).data.code;
      allow update, delete: if false;
    }
    // Kode verifikasi: tidak bisa dibaca klien; hanya pekerja yang tahu kode lama yang boleh menggantinya.
    match /config/reg {
      allow read: if false;
      allow update: if isStaff()
        && request.resource.data.keys().hasOnly(['code','prev'])
        && request.resource.data.prev == resource.data.code
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 6;
      allow create, delete: if false;
    }
    match /ingredients/{id} { allow read, write: if isStaff(); }
    match /menu/{id}        { allow read, write: if isStaff(); }
    match /closings/{id}    { allow read, write: if isStaff(); }
    match /transactions/{id} { allow read, create, update: if isStaff(); allow delete: if false; }
    match /stockmoves/{id}   { allow read, create: if isStaff(); allow update, delete: if false; }
    match /activity/{id}     { allow read, create: if isStaff(); allow update, delete: if false; }
  }
}
